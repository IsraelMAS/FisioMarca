# ─── FisioMarca · variables de docker compose ───────────────────────
# Opcional: copia este archivo a ".env" (docker compose lo lee solo).
# Sin .env se usan estos mismos valores por defecto.

# Clave de root del MySQL del contenedor
MYSQL_ROOT_PASSWORD=mysql

# JWT compartido por AUTH-SERVICE, Gateway, micros y frontend (Base64, mín. 32 bytes)
JWT_SECRET=/urSDUIrV3z7QBnshgjDKBw7+MgBEYIki+/z42yAm/E=
JWT_EXPIRATION=3600000

# Asistente IA del chatbot. Sin clave responde en modo local (botones + palabras clave)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
